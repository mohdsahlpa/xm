#include <stdio.h>

/**
 * Program 1: Hello World & Basic Arithmetic
 * Description: Demonstrates standard I/O and basic calculations in C.
 */

int main(void) {
    printf("========================================\n");
    printf("   Welcome to C Programming Laboratory  \n");
    printf("========================================\n\n");

    int a = 25, b = 15;
    printf("Values: a = %d, b = %d\n", a, b);
    printf("Addition:       %d + %d = %d\n", a, b, a + b);
    printf("Subtraction:    %d - %d = %d\n", a, b, a - b);
    printf("Multiplication: %d * %d = %d\n", a, b, a * b);
    printf("Division:       %d / %d = %d\n", a, b, a / b);
    printf("Modulus:        %d %% %d = %d\n\n", a, b, a % b);

    printf("Program completed successfully.\n");
    return 0;
}
