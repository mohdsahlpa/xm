/*
 * ============================================================================
 * Program 1: Lexical Analyzer using Lex
 * ============================================================================
 * Description:
 *   Identifies and classifies input tokens into Keywords, Identifiers,
 *   Operators, Separators, Float numbers, and Integers. Counts total tokens.
 *
 * COMPILATION STEPS (Linux / Ubuntu CLI):
 *   1. lex 1.l               # (or: flex 1.l) -> generates lex.yy.c
 *   2. gcc lex.yy.c -o 1      # (or: gcc lex.yy.c -lfl -o 1)
 *   3. ./1                    # Run the executable
 *
 * ONE-LINER:
 *   lex 1.l && gcc lex.yy.c -o 1 && ./1
 *
 * HOW TO TEST:
 *   $ ./1
 *   int a = 10;
 *   while (a <= 20) a++;
 *   [Press Ctrl+D to trigger EOF]
 * ============================================================================
 */

%{
#include <stdio.h>
int n = 0;
%}

%option noyywrap

%%
[ \t\n]+                            {}
"while"|"if"|"else"|"char"|"void"   { n++; printf("\tKeywords:%s\n", yytext); }
"int"|"float"                       { n++; printf("\tKeyword:%s\n", yytext); }
[a-zA-Z_][a-zA-Z0-9_]*              { n++; printf("\tidentifier:%s\n", yytext); }
"<="|"=="|"="|"++"|"-"|"+"|"*"      { n++; printf("\toperator:%s\n", yytext); }
[(){},;]                            { n++; printf("\tseperator:%s\n", yytext); }
[0-9]+\.[0-9]+                      { n++; printf("\tfloat:%s\n", yytext); }
[0-9]+                              { n++; printf("\tinteger:%s\n", yytext); }
.                                   {}
%%

int main() {
    yylex();
    printf("\n Total number of tokens=%d\n", n);
    return 0;
}
