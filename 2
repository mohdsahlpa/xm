/*
 * ============================================================================
 * Program 2: Word, Line, and Character Count using Lex
 * ============================================================================
 * COMPILATION STEPS:
 *   1. lex 2.l               
 *   2. gcc lex.yy.c -o 2      
 *   3. ./2
 *
 * HOW TO TEST:
 *   $ ./2
 *   Hello world
 *   Compiler design lab
 * ============================================================================
 */

%{
#include<stdio.h>
int lc=0, wc=0, cc=0;
%}

%%
\n          { lc++; cc++; }
[^ \t\n]+   { wc++; cc += yyleng; }
.           { cc++; }
%%

int main() {
    yylex();
    printf("Lines: %d | Words: %d | Characters: %d\n", lc, wc, cc);
    return 0;
}

int yywrap() { 
    return 1; 
}
