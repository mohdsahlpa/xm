/*
 * ============================================================================
 * Program 4: Count Number of Vowels and Consonants using Lex
 * ============================================================================
 *
 * COMPILATION STEPS:
 *   1. lex 4.l               
 *   2. gcc lex.yy.c -o 4     
 *   3. ./4                   
 *
 * HOW TO TEST:
 *   $ ./4
 *   Engineering
 *   [Press Ctrl+D to trigger EOF]
 *   Output: Vowels: 5 | Consonants: 6
 * ============================================================================
 */

%{
#include <stdio.h>
int vowels = 0, consonants = 0;
%}

%option noyywrap

%%
[aeiouAEIOU]    { vowels++; }
[a-zA-Z]        { consonants++; }
.|\n            { /* Ignore spaces, punctuation, and newlines */ }
%%

int main() {
    yylex();
    printf("Vowels: %d | Consonants: %d\n", vowels, consonants);
    return 0;
}
