/*
 * ============================================================================
 * Program 3: Replace Substring "abc" with "ABC" using Lex
 * ============================================================================
 *
 * COMPILATION STEPS:
 *   1. lex 3.l               
 *   2. gcc lex.yy.c -o 3      
 *   3. ./3                    
 *
 * HOW TO TEST:
 *   $ ./3
 *   abc test abc 123
 *   ABC test ABC 123
 * ============================================================================
 */

%{
#include <stdio.h>
%}

%%
"abc"   { printf("ABC"); }
\t      { return 0; }
.|\n    { ECHO; }
%%

int main() {
    yylex();
    return 0;
}

int yywrap() {
    return 1;
}
